#!/usr/bin/env bash
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# A convenience, not the control — a clone without that config has no hooks at all. The Guards
# workflow re-runs the same checks on push.

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
readonly repository_root

"${repository_root}/.github/scripts/check-emails.sh" staged
