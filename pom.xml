<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.vadimbabich</groupId>
  <artifactId>entity-metamodel-parent</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Entity Metamodel (parent)</name>
  <description>
    Reactor parent for the entity-metamodel family and the retiring 1.x Maven plugin. The reactor
    is deliberately mixed-version by design: the family releases from this version line; the
    plugin module keeps its own 1.1.x line and coordinates for its remaining releases. Releases
    are cut per line with scoped versions:set from dispatch inputs — nothing here is ever the
    release version of record.
  </description>
  <url>https://github.com/VadimBabich/jpa-metadata-maven-plugin</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>vadimbabich</id>
      <name>Vadim Babich</name>
      <url>https://github.com/VadimBabich</url>
    </developer>
  </developers>

  <!-- All four artifacts live in this one repository, so inherited URLs must not have the module
       directory appended: Maven's default would publish 404 project URLs and unclonable SCM
       connections, and Central validates their presence, not their resolvability. The attributes
       belong on the enclosing element — on <url>/<connection> they parse as unknown and are
       silently dropped. -->
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/VadimBabich/jpa-metadata-maven-plugin.git</connection>
    <developerConnection>scm:git:https://github.com/VadimBabich/jpa-metadata-maven-plugin.git</developerConnection>
    <url>https://github.com/VadimBabich/jpa-metadata-maven-plugin</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>jpa-metadata-maven-plugin</module>
    <module>entity-metamodel-bom</module>
    <module>entity-metamodel-core</module>
    <module>entity-metamodel-runtime</module>
  </modules>

  <properties>
    <java.release>17</java.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible builds. No tooling updates this automatically under the CI-driven
         release flow: the release workflow stamps it and the publishing checklist verifies
         it. Never hand-edit mid-cycle. -->
    <project.build.outputTimestamp>2026-08-08T00:00:00Z</project.build.outputTimestamp>

    <!-- Version numbers only. Nothing here is DECLARED or MANAGED for the reactor: a BOM
         import pulls the imported POM's effective dependencyManagement, parent-inherited
         entries included, so anything managed here would reach every consumer of
         entity-metamodel-bom. Modules reference these properties; the BOM stays a list of
         family artifacts. Dependencies defining a module's published surface keep their own
         pin: core is zero-dependency, runtime relational-only. -->
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>

    <junit.version>6.1.3</junit.version>
    <assertj-core.version>3.27.7</assertj-core.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Pinned for every module: super-POM defaults vary with the local Maven version,
             which would make jar bytes environment-dependent. Configuration stays per
             module — only the versions are shared. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- Inherited by every module so that a reactor-wide deploy resolves one repository;
       a module needing a different target overrides it locally. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/VadimBabich/jpa-metadata-maven-plugin</url>
    </repository>
  </distributionManagement>

  <profiles>
    <!-- Publication compliance artifacts (sources, javadoc, signatures, SBOM) and the
         Central Portal deployer. A profile, not always-on: GPG must not run on PRs/dev
         builds and the CI matrix stays cost-neutral. Inert until a release dispatch
         activates it. -->
    <profile>
      <id>release</id>
      <properties>
        <!-- Signing stays skipped until the GPG key and Actions secrets exist. The flip to
             false and the secret wiring are one indivisible change: the skip default must
             always match the secret state. -->
        <gpg.skip>true</gpg.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.3</version>
            <executions>
              <execution>
                <id>make-sbom</id>
                <phase>package</phase>
                <goals>
                  <goal>makeBom</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Dry-run friendly defaults: the deployment stops at VALIDATED and is
                   published or dropped explicitly (publishing runbook §3). autoPublish
                   flips only once the flow has earned trust. -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
