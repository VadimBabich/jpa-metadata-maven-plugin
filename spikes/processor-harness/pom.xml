<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.vadimbabich.spike</groupId>
  <artifactId>processor-harness-spike</artifactId>
  <version>0-SPIKE</version>
  <packaging>jar</packaging>

  <name>Combined processor spike (WS-10)</name>
  <description>
    Throwaway evidence asset. Answers three program questions with one minimal JSR-269 processor:
    golden-file byte parity, test-harness comparison across JDKs, and Gradle incremental-processing
    staleness. Never published, never part of the root reactor. See README.md.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Matches the integration test's consumer (src/it/simple-consumer/pom.xml), because the
         spike compiles that consumer's entity sources against the same substrate. -->
    <spring-data-r2dbc.version>3.5.0</spring-data-r2dbc.version>

    <!-- Deliberately the root pom's versions: they are already resolved in the local repository,
         which keeps this round offline-capable (Phase 2's harness jars are not). -->
    <junit.version>5.13.1</junit.version>
    <assertj-core.version>3.27.7</assertj-core.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>

    <!-- Under comparison; versions are the field data the harness ADR cites. -->
    <compile-testing.version>0.23.0</compile-testing.version>
    <cute.version>1.9.0</cute.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-r2dbc</artifactId>
      <version>${spring-data-r2dbc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Round 2 only: the two sugar harnesses under comparison. They re-assert a parity that is
         already green under ToolProvider, so a red cell here is a harness finding. -->
    <dependency>
      <groupId>com.google.testing.compile</groupId>
      <artifactId>compile-testing</artifactId>
      <version>${compile-testing.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.toolisticon.cute</groupId>
      <artifactId>cute</artifactId>
      <version>${cute.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <!-- The processor ships a META-INF/services registration for the Gradle staleness round.
               Without this, javac would discover it on the spike's own compile classpath and run it
               over the spike's own sources. -->
          <proc>none</proc>

          <!-- Standing in for IDE inspections: keeping the spike out of the root reactor also keeps
               it out of the IDE's project model, so the compiler is the only linter this module
               has. Warnings are failures because the spike's output is evidence. -->
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
          <failOnWarning>true</failOnWarning>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- The parity test compiles golden sources in-process and must hand javac a real
               classpath. Surefire's default manifest-only jar collapses java.class.path to a single
               booter jar, which javac cannot expand into compilable dependencies. -->
          <useManifestOnlyJar>false</useManifestOnlyJar>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
